# Copy to .env and adjust.

# Real minutes per game day in the online universe.
# 20 = a ski season passes in about 2 real days; 60-120 is calmer for friends who play in the evenings.
DAY_MINUTES=60

# Host port for the game. Use "127.0.0.1:8787" to hide it behind the bundled Caddy (https profile).
SNOWLINE_PORT=8787

# 1 when running behind a reverse proxy (the https profile or your own nginx/Traefik), else 0.
TRUST_PROXY=0

# Domain for automatic HTTPS with: docker compose --profile https up -d
DOMAIN=snowline.example.com
